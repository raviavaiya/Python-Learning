    "# NUmber Palindrome\n",
    "num = int(input(\"Enter a number: \"))\n",
    "if type(num) != int:\n",
    "    print(\"Please enter a valid number\")\n",
    "if num < 100:\n",
    "    print(\"Please enter a number greater than 100\")\n",
    "else:\n",
    "    rev_num = \"\"\n",
    "    for i in str(num):\n",
    "        rev_num = i + rev_num\n",
    "    print(rev_num)\n",
    "    if str(num) == rev_num:\n",
    "        print(f\"{num} is a palindrome\")\n",
    "    else:\n",
    "        print(f\"{num} is not a palindrome\")"
   ]
