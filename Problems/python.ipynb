   "source": [
    "# Armstrong number\n",
    "num = int(input(\"Enter a number: \"))\n",
    "if type(num) != int:\n",
    "    print(\"Please enter a valid number\")\n",
    "if num < 100:\n",
    "    print(\"Please enter a number greater than 100\")\n",
    "else:\n",
    "    sum = 0\n",
    "    for i in str(num):\n",
    "        sum += int(i)**3\n",
    "    if sum == num:\n",
    "        print(f\"{num} is an Armstrong number\")\n",
    "    else:\n",
    "        print(f\"{num} is not an Armstrong number\")"
   ]
